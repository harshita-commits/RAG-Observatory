# PowerShell: set these as $env:NAME = 'value'. The app does not auto-load this file.
# Local models: no API key. Compose already supplies these defaults.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATOR_MODEL=llama3.2:3b
JUDGE_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
MODEL_TIMEOUT_SECONDS=600
OLLAMA_NUM_THREADS=4
# Optional hosted provider (native launch only): LLM_PROVIDER=openai,
# OPENAI_API_KEY=..., GENERATOR_MODEL=gpt-4o-mini, JUDGE_MODEL=gpt-4o-mini,
# EMBEDDING_MODEL=text-embedding-3-small. Never mix local/cloud model names.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Optional: supply current, model-specific pricing. Never assumed by the project.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
